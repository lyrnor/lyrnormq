# 一个进程一份。3、5 或 7 台机器使用同一份成员表，只改 node.id、node.role 和 node.data_dir。
# 环境变量覆盖同名字段。

[node]
# 本机的稳定成员编号，必须是 cluster.members 里的某个 id。
# RMQTT_NODE_ID
id = 1
# controller、broker，或 controller,broker。顺序没有意义，不能重复。
# 只写 controller 时不要配置 [mqtt]。只写 broker 时本进程是 Broker 100 + id。
# RMQTT_NODE_ROLE
role = "controller,broker"
# Controller 与 Broker 的数据分别放在 data_dir/controller、data_dir/broker。
# 规则库、访问控制库和出站队列是 data_dir/rules.sqlite、data_dir/access.sqlite、data_dir/egress。
# 单机时会话库是 data_dir/sessions.sqlite。有 [cluster] 时不使用会话库。
# RMQTT_NODE_DATA_DIR
data_dir = "/opt/rmqtt/n1"

# 客户端监听地址。
[mqtt]
# RMQTT_MQTT_LISTEN
listen = "0.0.0.0:18831"
# both | 3.1.1 | 5
# RMQTT_MQTT_PROTOCOL
protocol = "both"

# 去掉本段后使用明文。公网地址没有 TLS 时拒绝启动。
[mqtt.tls]
# RMQTT_MQTT_TLS_CERT
cert = "/opt/rmqtt/cert.pem"
# RMQTT_MQTT_TLS_KEY
key = "/opt/rmqtt/key.pem"
# 去掉本键后不要求客户端证书。
# RMQTT_MQTT_TLS_CLIENT_CA
client_ca = "/opt/rmqtt/clients.pem"

# 去掉本段后只提供 TCP。
[mqtt.websocket]
# RMQTT_MQTT_WEBSOCKET_PATH
path = "/mqtt"

# 去掉本段后是单机，并且不能写 node.role。
# id 是成员身份，确定后不能改。host 只是当前地址，可以改。
# 数组顺序没有意义。
# node.role 决定本进程启动哪些角色。
# controller 使用 id，broker 使用 100 + id。
# Controller 监听 host:controller_port，Broker 监听 host:broker_port。
# Broker 对外地址是 http://host:broker_port。
# 全部成员构成 Controller 组和数据副本组。成员数必须是 3、5 或 7，与 etcd 的实际上限一致。
# backend = "memory" 时副本只在内存中，进程退出后丢失。
# backend = "rocksdb" 时副本在确认前同步写入 data_dir/broker/rocks，重启后保留。
# 同一集群必须使用同一个 backend。改成 rocksdb 前先升级全部 Controller。
# 编号最小的成员在 Raft 尚未初始化时创建集群。租约 3000 毫秒。
[cluster]
# RMQTT_CLUSTER_ID
id = "rmqtt"
# RMQTT_CLUSTER_TOKEN_FILE
token_file = "/opt/rmqtt/peer.token"
# RMQTT_CLUSTER_CONTROLLER_PORT
controller_port = 17001
# RMQTT_CLUSTER_BROKER_PORT
broker_port = 17101
# RMQTT_CLUSTER_MEMBERS=1:172.16.240.180,2:172.16.240.182,3:172.16.240.183
# RMQTT_CLUSTER_BACKEND=memory
# backend = "rocksdb"
members = [
    { id = 1, host = "172.16.240.180" },
    { id = 2, host = "172.16.240.182" },
    { id = 3, host = "172.16.240.183" },
]

# 去掉本段后不监听管理端口。
[dashboard]
# RMQTT_DASHBOARD_LISTEN
listen = "127.0.0.1:18083"
# RMQTT_DASHBOARD_TOKEN_FILE
token_file = "/opt/rmqtt/dashboard.token"
# RMQTT_DASHBOARD_DIR
dir = "/opt/rmqtt/dashboard"

# 去掉本段后允许匿名连接。
[auth]
# RMQTT_AUTH_POLICY
policy = "/opt/rmqtt/policy.json"
# 为真时启用内置 PLAIN 认证。
# RMQTT_AUTH_PLAIN
plain = false

# 去掉本段后使用这里列出的数值。
[limits]
# RMQTT_LIMITS_CONNECTIONS
connections = 1024
# RMQTT_LIMITS_SESSIONS
sessions = 1024
# RMQTT_LIMITS_INFLIGHT
inflight = 32
# RMQTT_LIMITS_PACKET_BYTES
packet_bytes = 1048576
# RMQTT_LIMITS_SUBSCRIPTIONS
subscriptions = 256
# RMQTT_LIMITS_RETAINED
retained = 10000
# RMQTT_LIMITS_STATE_BYTES
state_bytes = 67108864
# RMQTT_LIMITS_OUTBOUND
outbound = 64
# RMQTT_LIMITS_HANDSHAKE_MS
handshake_ms = 10000
# RMQTT_LIMITS_WRITE_MS
write_ms = 5000
# RMQTT_LIMITS_HANDSHAKES
handshakes = 128
# RMQTT_LIMITS_AUTH_TASKS
auth_tasks = 4
# RMQTT_LIMITS_AUTH_RATE_PER_SECOND
auth_rate = 1000
# RMQTT_LIMITS_AUTH_BURST
auth_burst = 1000
# RMQTT_LIMITS_ALIAS_MAXIMUM
alias_maximum = 32

# 去掉本段后出站队列在 data_dir/egress，分段 1MiB，物理上限 256MiB，待发送 100000 条。
[egress]
# RMQTT_EGRESS_DIR
dir = "/opt/rmqtt/n1/egress"
# RMQTT_EGRESS_SEGMENT_BYTES
segment_bytes = 1048576
# RMQTT_EGRESS_MAX_BYTES
max_bytes = 268435456
# RMQTT_EGRESS_MAX_RECORDS
max_records = 100000
