{
  "openapi": "3.1.0",
  "info": {
    "title": "RMQTT external HTTP authentication and ACL API",
    "version": "1.0.0",
    "description": "Simplified v1 replaces the unimplemented earlier draft. Broker is the HTTP client. No api_version, request_id, transport/stage context in body. HTTP backend not implemented. Normative details: ../http-auth-api.md. Bearer is the example service credential; deployment may require mTLS/fixed headers."
  },
  "servers": [
    {
      "url": "https://auth.example.com"
    }
  ],
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "paths": {
    "/mqtt/authenticate": {
      "post": {
        "operationId": "authenticate",
        "summary": "Verify client credentials",
        "description": "Broker calls business service. HTTP200 carries allow/deny or a complete ACL. All other statuses are service failure, not MQTT user decisions. See ../http-auth-api.md.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Optional tracing only. Service may ignore; response echo not required."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              },
              "examples": {
                "credentials": {
                  "value": {
                    "client_id": "device-001",
                    "username": "alice",
                    "password": "secret"
                  }
                },
                "binaryPassword": {
                  "value": {
                    "client_id": "device-001",
                    "username": "alice",
                    "password_base64": "/wA="
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid business response, <=64KiB. Reject unknown fields, duplicate keys and invalid types. Cache duration and correlation live in Broker configuration/state, not body.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "allow": {
                    "value": {
                      "result": "allow",
                      "user_id": "42"
                    }
                  },
                  "deny": {
                    "value": {
                      "result": "deny"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Service failure. 401/403 service credentials/access, 404 endpoint, 429/503 overload/unavailable. Never implicit allow, user-not-found or anonymous fallback."
          }
        }
      }
    },
    "/mqtt/acl": {
      "post": {
        "operationId": "fetchAcl",
        "summary": "Fetch complete user permissions",
        "description": "Broker calls business service. HTTP200 carries allow/deny or a complete ACL. All other statuses are service failure, not MQTT user decisions. See ../http-auth-api.md.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Optional tracing only. Service may ignore; response echo not required."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AclRequest"
              },
              "examples": {
                "user": {
                  "value": {
                    "user_id": "42"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid business response, <=64KiB. Reject unknown fields, duplicate keys and invalid types. Cache duration and correlation live in Broker configuration/state, not body.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclResponse"
                },
                "examples": {
                  "basic": {
                    "value": {
                      "publish": [
                        "devices/device-001/telemetry"
                      ],
                      "subscribe": [
                        "devices/device-001/commands/#"
                      ]
                    }
                  },
                  "advanced": {
                    "value": {
                      "client_id_prefix": "device-",
                      "publish": [
                        "devices/#"
                      ],
                      "subscribe": [
                        "devices/#"
                      ],
                      "deny": {
                        "publish": [
                          "devices/private/#"
                        ],
                        "subscribe": [
                          "devices/private/#"
                        ]
                      }
                    }
                  },
                  "deny": {
                    "value": {
                      "result": "deny"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Service failure. 401/403 service credentials/access, 404 endpoint, 429/503 overload/unavailable. Never implicit allow, user-not-found or anonymous fallback."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Broker-to-service credential; not MQTT user password."
      },
      "ClientCertificate": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "UserId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "x-max-utf8-bytes": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "AuthRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535,
            "x-max-utf8-bytes": 65535
          },
          "username": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 65535,
                "x-max-utf8-bytes": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "password": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 65535,
                "x-max-utf8-bytes": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "password_base64": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 87380,
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                "description": "Only for non-UTF8 passwords. Canonical RFC4648, decoded <=65535 bytes. Never include together with password, including null."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "not": {
          "required": [
            "password",
            "password_base64"
          ]
        }
      },
      "AuthAllow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "user_id"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "allow"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        }
      },
      "AuthDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "deny"
          },
          "reason": {
            "type": "string",
            "enum": [
              "bad_credentials",
              "not_authorized"
            ],
            "default": "bad_credentials"
          }
        }
      },
      "AuthResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthAllow"
          },
          {
            "$ref": "#/components/schemas/AuthDeny"
          }
        ]
      },
      "AclRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id"
        ],
        "properties": {
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        }
      },
      "DenyFilters": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "publish": {
            "type": "array",
            "default": [],
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "description": "Valid MQTT Topic Filter, no shared-subscription wrapper; semantic MQTT and UTF8-byte validation required."
            }
          },
          "subscribe": {
            "type": "array",
            "default": [],
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "description": "Valid MQTT Topic Filter, no shared-subscription wrapper; semantic MQTT and UTF8-byte validation required."
            }
          }
        }
      },
      "AclPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [],
        "properties": {
          "publish": {
            "type": "array",
            "default": [],
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "description": "Valid MQTT Topic Filter, no shared-subscription wrapper; semantic MQTT and UTF8-byte validation required."
            }
          },
          "subscribe": {
            "type": "array",
            "default": [],
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "description": "Valid MQTT Topic Filter, no shared-subscription wrapper; semantic MQTT and UTF8-byte validation required."
            }
          },
          "client_id_prefix": {
            "type": "string",
            "minLength": 0,
            "maxLength": 1024,
            "x-max-utf8-bytes": 1024,
            "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$",
            "default": ""
          },
          "deny": {
            "$ref": "#/components/schemas/DenyFilters"
          }
        },
        "x-max-total-filters": 128,
        "description": "Complete snapshot. Missing lists mean no permissions. Subscribe lists govern both subscribing and actual receiving, including their deny lists. Missing client_id_prefix means no extra client range restriction. Explicit deny wins. At most128 filters across all four lists."
      },
      "AclDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "deny"
          }
        }
      },
      "AclResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AclPolicy"
          },
          {
            "$ref": "#/components/schemas/AclDeny"
          }
        ]
      }
    }
  }
}
