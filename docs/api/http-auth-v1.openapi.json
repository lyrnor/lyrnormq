{
  "openapi": "3.1.0",
  "info": {
    "title": "RMQTT external HTTP authentication and ACL API",
    "version": "1.0.0",
    "description": "Simplified unimplemented v1. Broker calls business service: authenticate credentials, then request point authorization using user_id/client_id/action/topic. Decision cache is exact-key and Broker-managed; misses cause remote IO. Supersedes previous full-policy draft. Normative contract: ../http-auth-api.md."
  },
  "servers": [
    {
      "url": "https://auth.example.com"
    }
  ],
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "paths": {
    "/mqtt/authenticate": {
      "post": {
        "operationId": "authenticate",
        "summary": "Verify client credentials",
        "description": "Broker calls business service. HTTP200 carries allow/deny or a complete ACL. All other statuses are service failure, not MQTT user decisions. See ../http-auth-api.md.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Optional tracing only. Service may ignore; response echo not required."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              },
              "examples": {
                "credentials": {
                  "value": {
                    "client_id": "device-001",
                    "username": "alice",
                    "password": "secret"
                  }
                },
                "binaryPassword": {
                  "value": {
                    "client_id": "device-001",
                    "username": "alice",
                    "password_base64": "/wA="
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Valid business response, <=64KiB. Reject unknown fields, duplicate keys and invalid types. Cache duration and correlation live in Broker configuration/state, not body.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "allow": {
                    "value": {
                      "result": "allow",
                      "user_id": "42"
                    }
                  },
                  "deny": {
                    "value": {
                      "result": "deny"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Service failure. 401/403 service credentials/access, 404 endpoint, 429/503 overload/unavailable. Never implicit allow, user-not-found or anonymous fallback."
          }
        }
      }
    },
    "/mqtt/acl": {
      "post": {
        "operationId": "fetchAcl",
        "summary": "Authorize one client operation on one topic or filter",
        "description": "Broker asks an exact (user_id, client_id, action, topic) question. Return only allow/deny. No policy arrays, wildcard cache inference or user-wide revocation. Cache misses require bounded asynchronous HTTP outside session actor. See ../http-auth-api.md.",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": false,
            "schema": {
              "type": "string",
              "maxLength": 64
            },
            "description": "Optional tracing only. Service may ignore; response echo not required."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AclRequest"
              },
              "examples": {
                "publish": {
                  "value": {
                    "user_id": "42",
                    "client_id": "device-001",
                    "action": "publish",
                    "topic": "devices/device-001/telemetry"
                  }
                },
                "subscribe": {
                  "value": {
                    "user_id": "42",
                    "client_id": "device-001",
                    "action": "subscribe",
                    "topic": "devices/device-001/commands/#"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Exact business decision for this request, <=64KiB. Deny affects this request only. No echo/TTL/full policy; unknown fields or an empty object are invalid.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclResponse"
                },
                "examples": {
                  "allow": {
                    "value": {
                      "result": "allow"
                    }
                  },
                  "deny": {
                    "value": {
                      "result": "deny"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Service failure. 401/403 service credentials/access, 404 endpoint, 429/503 overload/unavailable. Never implicit allow, user-not-found or anonymous fallback."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Broker-to-service credential; not MQTT user password."
      },
      "ClientCertificate": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "UserId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "x-max-utf8-bytes": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "AuthRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "client_id"
        ],
        "properties": {
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535,
            "x-max-utf8-bytes": 65535
          },
          "username": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 65535,
                "x-max-utf8-bytes": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "password": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 65535,
                "x-max-utf8-bytes": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "password_base64": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 87380,
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                "description": "Only for non-UTF8 passwords. Canonical RFC4648, decoded <=65535 bytes. Never include together with password, including null."
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "not": {
          "required": [
            "password",
            "password_base64"
          ]
        }
      },
      "AuthAllow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result",
          "user_id"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "allow"
          },
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          }
        }
      },
      "AuthDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "deny"
          },
          "reason": {
            "type": "string",
            "enum": [
              "bad_credentials",
              "not_authorized"
            ],
            "default": "bad_credentials"
          }
        }
      },
      "AuthResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthAllow"
          },
          {
            "$ref": "#/components/schemas/AuthDeny"
          }
        ]
      },
      "AclRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "user_id",
          "client_id",
          "action",
          "topic"
        ],
        "properties": {
          "user_id": {
            "$ref": "#/components/schemas/UserId"
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535,
            "x-max-utf8-bytes": 65535
          },
          "action": {
            "type": "string",
            "enum": [
              "publish",
              "subscribe"
            ]
          },
          "topic": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535,
            "x-max-utf8-bytes": 65535,
            "pattern": "^[^\\u0000]+$",
            "description": "Publish: concrete valid MQTT Topic Name. Subscribe: valid MQTT Topic Filter; concrete Topic used for actual receiving. Broker strips shared wrapper only for initial shared subscription. Service must authorize full requested filter range."
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "action": {
                  "const": "publish"
                }
              }
            },
            "then": {
              "properties": {
                "topic": {
                  "pattern": "^[^+#\\u0000]+$"
                }
              }
            }
          }
        ]
      },
      "AclDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "deny"
          }
        }
      },
      "AclResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AclAllow"
          },
          {
            "$ref": "#/components/schemas/AclDeny"
          }
        ]
      },
      "AclAllow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "result"
        ],
        "properties": {
          "result": {
            "type": "string",
            "const": "allow"
          }
        }
      }
    }
  }
}
