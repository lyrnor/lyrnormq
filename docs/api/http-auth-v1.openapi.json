{
  "openapi": "3.1.0",
  "info": {
    "title": "RMQTT external HTTP authentication and ACL API",
    "version": "1.0.0",
    "description": "External interface contract only; backend not yet implemented. Broker is HTTP client, business service implements these endpoints. Paths are configurable examples. See ../http-auth-api.md for byte limits, deny/containment/cache/recovery semantics. Bearer is the example service authentication; deployment may additionally require mTLS or configured headers."
  },
  "servers": [
    {
      "url": "https://auth.example.com"
    }
  ],
  "security": [
    {
      "ServiceToken": []
    }
  ],
  "paths": {
    "/mqtt/authenticate": {
      "post": {
        "operationId": "authenticate",
        "summary": "Validate MQTT credentials and return stable identity",
        "description": "Business decisions require HTTP200. Every other status is backend unavailable; never implicit allow. Full semantics: ../http-auth-api.md",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            },
            "description": "Must equal body request_id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AuthRequest"
              },
              "example": {
                "api_version": 1,
                "request_id": "auth-01",
                "stage": "connect",
                "client_id": "device-001",
                "username": "alice",
                "password_base64": "c2VjcmV0",
                "mqtt_version": "5.0",
                "transport": "tls",
                "peer_ip": "192.0.2.10",
                "peer_port": 56789,
                "authentication_method": null,
                "current_principal": null
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete business decision. Version and request ID must match. ACL principal must match. Duplicate keys and unknown fields are invalid. Response <=64KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AuthResponse"
                },
                "examples": {
                  "allow": {
                    "value": {
                      "api_version": 1,
                      "request_id": "auth-01",
                      "result": "allow",
                      "principal": "user:42"
                    }
                  },
                  "deny-bad_credentials": {
                    "value": {
                      "api_version": 1,
                      "request_id": "auth-01",
                      "result": "deny",
                      "reason": "bad_credentials"
                    }
                  },
                  "deny-not_authorized": {
                    "value": {
                      "api_version": 1,
                      "request_id": "auth-01",
                      "result": "deny",
                      "reason": "not_authorized"
                    }
                  },
                  "not_found": {
                    "value": {
                      "api_version": 1,
                      "request_id": "auth-01",
                      "result": "not_found"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Backend unavailable or protocol error, not a MQTT user decision. 401/403 service access credentials; 404 endpoint; 429/503 overload/unavailable. Body ignored, never auto-fallback."
          }
        }
      }
    },
    "/mqtt/acl": {
      "post": {
        "operationId": "fetchAcl",
        "summary": "Fetch a complete principal-scoped ACL snapshot",
        "description": "Business decisions require HTTP200. Every other status is backend unavailable; never implicit allow. Full semantics: ../http-auth-api.md",
        "parameters": [
          {
            "in": "header",
            "name": "X-Request-ID",
            "required": true,
            "schema": {
              "$ref": "#/components/schemas/RequestId"
            },
            "description": "Must equal body request_id."
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/AclRequest"
              },
              "example": {
                "api_version": 1,
                "request_id": "acl-01",
                "principal": "user:42"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Complete business decision. Version and request ID must match. ACL principal must match. Duplicate keys and unknown fields are invalid. Response <=64KiB.",
            "headers": {
              "Cache-Control": {
                "schema": {
                  "type": "string",
                  "const": "no-store"
                }
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AclResponse"
                },
                "examples": {
                  "ok": {
                    "value": {
                      "api_version": 1,
                      "request_id": "acl-01",
                      "result": "ok",
                      "principal": "user:42",
                      "revision": "policy-17",
                      "ttl_seconds": 30,
                      "connect": {
                        "allow_client_id_prefixes": [
                          "device-"
                        ],
                        "deny_client_id_prefixes": [
                          "device-blocked-"
                        ]
                      },
                      "rules": [
                        {
                          "id": "telemetry",
                          "effect": "allow",
                          "actions": [
                            "publish"
                          ],
                          "topic_filter": "devices/device-001/telemetry"
                        },
                        {
                          "id": "commands",
                          "effect": "allow",
                          "actions": [
                            "subscribe",
                            "receive"
                          ],
                          "topic_filter": "devices/device-001/commands/#"
                        },
                        {
                          "id": "system",
                          "effect": "deny",
                          "actions": [
                            "publish",
                            "subscribe",
                            "receive"
                          ],
                          "topic_filter": "$SYS/#"
                        }
                      ]
                    }
                  },
                  "deny-not_authorized": {
                    "value": {
                      "api_version": 1,
                      "request_id": "acl-01",
                      "result": "deny",
                      "principal": "user:42",
                      "reason": "not_authorized"
                    }
                  }
                }
              }
            }
          },
          "default": {
            "description": "Backend unavailable or protocol error, not a MQTT user decision. 401/403 service access credentials; 404 endpoint; 429/503 overload/unavailable. Body ignored, never auto-fallback."
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "ServiceToken": {
        "type": "http",
        "scheme": "bearer",
        "description": "Broker service credential, never MQTT user password."
      },
      "ClientCertificate": {
        "type": "mutualTLS"
      }
    },
    "schemas": {
      "RequestId": {
        "type": "string",
        "minLength": 1,
        "maxLength": 64,
        "x-max-utf8-bytes": 64,
        "pattern": "^[A-Za-z0-9_-]+$"
      },
      "Principal": {
        "type": "string",
        "minLength": 1,
        "maxLength": 256,
        "x-max-utf8-bytes": 256,
        "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]+$"
      },
      "AuthRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "stage",
          "client_id",
          "username",
          "password_base64",
          "mqtt_version",
          "transport",
          "peer_ip",
          "peer_port",
          "authentication_method",
          "current_principal"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "stage": {
            "type": "string",
            "enum": [
              "connect",
              "reauthenticate"
            ]
          },
          "client_id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 65535,
            "x-max-utf8-bytes": 65535
          },
          "username": {
            "oneOf": [
              {
                "type": "string",
                "minLength": 0,
                "maxLength": 65535,
                "x-max-utf8-bytes": 65535
              },
              {
                "type": "null"
              }
            ]
          },
          "password_base64": {
            "oneOf": [
              {
                "type": "string",
                "maxLength": 87380,
                "contentEncoding": "base64",
                "pattern": "^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$",
                "description": "Canonical RFC4648 base64; decoded bytes <=65535; null absent, empty string explicitly empty. Never interpret as UTF-8."
              },
              {
                "type": "null"
              }
            ]
          },
          "mqtt_version": {
            "type": "string",
            "enum": [
              "3.1.1",
              "5.0"
            ]
          },
          "transport": {
            "type": "string",
            "enum": [
              "tcp",
              "tls",
              "ws",
              "wss"
            ]
          },
          "peer_ip": {
            "type": "string",
            "maxLength": 45,
            "anyOf": [
              {
                "format": "ipv4"
              },
              {
                "format": "ipv6"
              }
            ],
            "description": "Actual TCP peer, no forwarded-header trust, IPv6 brackets or scope IDs."
          },
          "peer_port": {
            "type": "integer",
            "minimum": 1,
            "maximum": 65535
          },
          "authentication_method": {
            "oneOf": [
              {
                "const": "PLAIN",
                "type": "string"
              },
              {
                "type": "null"
              }
            ]
          },
          "current_principal": {
            "oneOf": [
              {
                "$ref": "#/components/schemas/Principal"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "stage": {
                  "const": "connect"
                }
              }
            },
            "then": {
              "properties": {
                "current_principal": {
                  "type": "null"
                }
              }
            },
            "else": {
              "properties": {
                "current_principal": {
                  "$ref": "#/components/schemas/Principal"
                },
                "mqtt_version": {
                  "const": "5.0"
                },
                "authentication_method": {
                  "const": "PLAIN"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "authentication_method": {
                  "const": "PLAIN"
                }
              }
            },
            "then": {
              "properties": {
                "mqtt_version": {
                  "const": "5.0"
                }
              }
            }
          }
        ]
      },
      "AuthAllow": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "result",
          "principal"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "result": {
            "const": "allow",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        }
      },
      "AuthDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "result",
          "reason"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "result": {
            "const": "deny",
            "type": "string"
          },
          "reason": {
            "type": "string",
            "enum": [
              "bad_credentials",
              "not_authorized"
            ]
          }
        }
      },
      "AuthNotFound": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "result"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "result": {
            "const": "not_found",
            "type": "string"
          }
        }
      },
      "AuthResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AuthAllow"
          },
          {
            "$ref": "#/components/schemas/AuthDeny"
          },
          {
            "$ref": "#/components/schemas/AuthNotFound"
          }
        ]
      },
      "AclRequest": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "principal"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          }
        }
      },
      "ConnectPolicy": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "allow_client_id_prefixes",
          "deny_client_id_prefixes"
        ],
        "properties": {
          "allow_client_id_prefixes": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          },
          "deny_client_id_prefixes": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "type": "string",
              "minLength": 0,
              "maxLength": 1024,
              "x-max-utf8-bytes": 1024,
              "pattern": "^[^\\u0000-\\u001f\\u007f-\\u009f]*$"
            }
          }
        }
      },
      "AclRule": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "effect",
          "actions",
          "topic_filter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64,
            "x-max-utf8-bytes": 64,
            "pattern": "^[A-Za-z0-9_-]+$"
          },
          "effect": {
            "type": "string",
            "enum": [
              "allow",
              "deny"
            ]
          },
          "actions": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "enum": [
                "publish",
                "subscribe",
                "receive"
              ]
            }
          },
          "topic_filter": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024,
            "x-max-utf8-bytes": 1024,
            "description": "Valid MQTT Topic Filter, no shared-subscription wrapper. MQTT validation and byte cap are normative."
          }
        }
      },
      "AclOk": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "result",
          "principal",
          "revision",
          "ttl_seconds",
          "connect",
          "rules"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "result": {
            "const": "ok",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "revision": {
            "type": "string",
            "minLength": 1,
            "maxLength": 128,
            "x-max-utf8-bytes": 128,
            "pattern": "^[\\x21-\\x7e]+$"
          },
          "ttl_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 300
          },
          "connect": {
            "$ref": "#/components/schemas/ConnectPolicy"
          },
          "rules": {
            "type": "array",
            "maxItems": 128,
            "items": {
              "$ref": "#/components/schemas/AclRule"
            }
          }
        }
      },
      "AclDeny": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "api_version",
          "request_id",
          "result",
          "principal",
          "reason"
        ],
        "properties": {
          "api_version": {
            "type": "integer",
            "const": 1
          },
          "request_id": {
            "$ref": "#/components/schemas/RequestId"
          },
          "result": {
            "const": "deny",
            "type": "string"
          },
          "principal": {
            "$ref": "#/components/schemas/Principal"
          },
          "reason": {
            "type": "string",
            "const": "not_authorized"
          }
        }
      },
      "AclResponse": {
        "oneOf": [
          {
            "$ref": "#/components/schemas/AclOk"
          },
          {
            "$ref": "#/components/schemas/AclDeny"
          }
        ]
      }
    }
  }
}
