{
  "connectors": [{
    "id": "alarm-service",
    "name": "告警 Webhook",
    "url": "http://127.0.0.1:9001/events",
    "headers": {}
  }],
  "actions": [{
    "id": "send-alarm",
    "name": "发送高温告警",
    "connector_id": "alarm-service",
    "enabled": true,
    "batch_size": 50,
    "batch_wait_ms": 100,
    "queue_capacity": 256,
    "timeout_ms": 3000,
    "max_attempts": 3,
    "retry_base_ms": 100
  }],
  "rules": [{
    "id": "high-temperature",
    "name": "设备高温告警",
    "sql": "SELECT client_id, topic AS source_topic, payload.device_id AS device_id, payload.temperature AS temperature FROM \"devices/+/telemetry\" WHERE payload.temperature >= 80",
    "enabled": true,
    "action_ids": ["send-alarm"]
  }]
}
