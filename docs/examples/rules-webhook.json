{
  "schema_version": 2,
  "outbounds": [{
    "id": "send-alarm",
    "name": "Alarm service",
    "enabled": true,
    "type": "webhook",
    "config": {
      "url": "https://example.com/events",
      "headers": {"Authorization": "Bearer replace-me"}
    },
    "delivery": {
      "batch_size": 100,
      "batch_wait_ms": 50,
      "queue_capacity": 256,
      "timeout_ms": 3000,
      "max_attempts": 3,
      "retry_base_ms": 200
    }
  }],
  "rules": [{
    "id": "hot",
    "name": "High temperature",
    "sql": "SELECT client_id, topic AS source_topic, payload.temperature AS temperature FROM \"devices/+/telemetry\" WHERE payload.temperature >= 80",
    "enabled": true,
    "outbound_ids": ["send-alarm"]
  }]
}
